#!/bin/sh
# SysVinit service for the stock LicheeRV Nano buildroot image.
# Install: cp to /etc/init.d/S99vela && chmod +x /etc/init.d/S99vela
# Binary at /root/vela, config at /etc/vela.env (legacy /etc/nanoclaw.env keys still honored), data on the SD.

DAEMON=/root/vela
LOG=/root/vela.log
PIDFILE=/var/run/vela.pid

start() {
    printf "Starting vela: "
    start-stop-daemon -S -b -m -p "$PIDFILE" --exec /bin/sh -- -c \
        "exec $DAEMON >> $LOG 2>&1"
    echo "OK"
}
stop() {
    printf "Stopping vela: "
    start-stop-daemon -K -p "$PIDFILE"
    echo "OK"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
