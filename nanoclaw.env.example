# nanoclaw configuration — copy to /etc/nanoclaw.env on the board
# (or keep next to the binary as ./nanoclaw.env)

# Discord bot token — https://discord.com/developers/applications
# Enable the MESSAGE CONTENT intent under Bot settings.
DISCORD_TOKEN=

# DeepSeek API key — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Channels answered WITHOUT an @mention (comma-separated channel IDs).
# Everywhere else the bot answers when @mentioned, and in DMs.
FOCUS_CHANNELS=

# Where memory, history, and artifacts live — point at the microSD mount.
NANOCLAW_DATA=/mnt/sd/nanoclaw

# deepseek-chat (tool calling, cheap) — deepseek-reasoner has no tool support.
# If your account has a flash-tier model, use it: nanoclaw is built around the
# looper play (cheap model × more passes > pricey model × one shot).
NANOCLAW_MODEL=deepseek-chat

# Self-review passes on NORMAL turns (1-8). Default 1: answer once, stay
# snappy — looping every reply made her feel slow. The looper play (draft →
# critique → repair, with a doubled tool budget) lives in the /dive command;
# NANOCLAW_DIVE_PASSES sets its passes (default 2).
NANOCLAW_PASSES=1
NANOCLAW_DIVE_PASSES=2

# Vision model — reads images sent to Discord (snap a card, ask its value; drop
# a screenshot, ask about it). Must be a multimodal model on your endpoint.
# Blank disables image reading. Default: stepfun/step-3.7-flash.
NANOCLAW_VISION_MODEL=stepfun/step-3.7-flash

# ── Group presence & learning (2.0) ─────────────────────────────────────
# How chatty Vela is UNPROMPTED in guild channels (0-1). She reads everything,
# scores interest locally (free), and occasionally chimes in when a channel's
# accumulated willingness clears the bar. 0 = never speaks unless mentioned /
# DM'd / focus channel. Default 0.3 — present but not noisy.
NANOCLAW_TALK_VALUE=0.3
# Continuous learning: per-person impressions (updated every ~45 messages) and
# per-channel expression learning (how each room talks, every ~6h). "off"
# disables both. Default on.
NANOCLAW_LEARNING=on

# Brave Search API key (optional) — a real search API instead of scraping
# DuckDuckGo HTML. Get one at https://brave.com/search/api/. Without it,
# web_search falls back to DDG. The tcg + attach_image tools need no key.
BRAVE_API_KEY=

# ── Code capability (optional): shell, files, git push ──────────────────
# Discord user IDs allowed to run shell/build/git — comma-separated. THIS IS
# ROOT-LEVEL TRUST: a shell can read the process env and any secret the bot
# holds, so only add people you trust with the whole box.
# Blank = the code capability is completely off.
NANOCLAW_CODERS=

# Where code lives and shell runs (defaults to <NANOCLAW_DATA>/workspace).
NANOCLAW_WORKSPACE=

# Vela's OWN GitHub token — enables authenticated `git push`. A coder shell can
# read this from the environment, so scope it to blast radius: a FINE-GRAINED
# PAT limited to her own repos, contents + pull-request write only, NO admin,
# and treat it as rotatable/burnable.
GITHUB_TOKEN=
GIT_NAME=Vela
GIT_EMAIL=

# GitHub API tool (create repos, write files, open PRs — acts as Vela's own
# account via GITHUB_TOKEN). This runs NO code on the box, so it's open to the
# whole server by default. Restrict it to these Discord IDs; blank = everyone.
# (Actually running/building code is the separate NANOCLAW_CODERS shell.)
NANOCLAW_REPO_USERS=

# ── Moderation (optional) ───────────────────────────────────────────────
# Discord user IDs allowed to have Vela moderate (timeout/kick/ban/delete/
# slowmode) — comma-separated. Blank = moderation is OFF and the tool is not
# even offered. The BOT also needs the matching server permissions (Moderate
# Members, Kick, Ban, Manage Messages, Manage Channel) and the Server Members
# gateway intent (enable it under Bot settings).
NANOCLAW_MODS=

# ── Deploy secrets ──────────────────────────────────────────────────────
# Deploy keys (Hetzner, etc.) are added on the box — KEY=VALUE lines in
# <NANOCLAW_DATA>/secrets.env — never typed in chat. Values are injected into shell as
# env vars BY NAME, never enter the model's context/history/memory, and are
# wiped by clear_secrets or the TTL below.
# Auto-wipe backstop in minutes (1-1440, default 120):
NANOCLAW_SECRET_TTL_MIN=120

# ── Image & video generation via xAI / Grok (optional) ──────────────────
# TWO ways to authenticate — pick either:
#  1. A SuperGrok / X Premium+ SUBSCRIPTION via OAuth — no key needed. An admin
#     runs `/grok login` in Discord, opens the link, approves, done. Tokens are
#     stored on the SD (grok-auth.json, 0600) and auto-refresh. Nothing to set
#     here for this path.
#  2. A pay-as-you-go API key from https://console.x.ai (billed by credits):
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video-1.5
# Restrict who can spend on generation to these Discord IDs; blank = everyone.
NANOCLAW_IMAGE_USERS=

# ── Model-release tracking (optional) ───────────────────────────────────
# Hugging Face orgs to watch for new releases (comma-separated). Blank uses a
# sensible default set (deepseek-ai, Qwen, meta-llama, mistralai, google,
# openai, microsoft, nvidia, moonshotai, zai-org). No API key needed.
NANOCLAW_MODEL_ORGS=

# ── Holodeck demo hosting (optional) ────────────────────────────────────
# Vela's own demo sandbox (github.com/novaoc/holodeck) — she deploys apps she builds and shares
# a live link on your domain; the whole deck wipes daily at 3AM Mexico City (repos
# are the permanent copy). Token must match the holodeck server's.
NANOCLAW_SANDBOX_URL=
NANOCLAW_SANDBOX_TOKEN=
# Shared HMAC secret proving deploys are Vela's own builds (must match holodeck's
# HOLODECK_BUILD_SECRET). Without it, deploy_demo is off.
NANOCLAW_SANDBOX_SECRET=

# ── /request forum ──────────────────────────────────────────────────────
# Forum channel where /request opens goal posts (name or id). Default: a
# forum channel named "requests".
NANOCLAW_REQUESTS_FORUM=requests
