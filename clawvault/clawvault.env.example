# clawvault configuration — copy to /etc/clawvault.env, chmod 600, owned by
# the clawvault user only. This file holds the keys' encryption secret and
# clawvault's own Discord token; nanoclaw's user must NOT be able to read it.

# Encryption secret for connected wallet keys. Generate with
# ../deploy/gen-secret.sh and keep it OFF the microSD if you can.
NANOCLAW_SECRET=

# clawvault's OWN Discord application/bot token (separate from Vela's). This
# is the bot users run /connect on and that shows trade Confirm buttons, so
# the bk_ key never touches nanoclaw. Enable the Message Content intent is NOT
# needed — it uses slash commands + buttons only.
VAULT_DISCORD_TOKEN=

# Optional: restrict slash-command registration to specific guild IDs.
VAULT_GUILDS=

# Where keys + audit log live (defaults to ./vault-data). Point at the
# clawvault user's home on the SD.
CLAWVAULT_DATA=/var/lib/clawvault
CLAWVAULT_SOCKET=/var/lib/clawvault/clawvault.sock

# Per-user daily cap on fund-moving actions (backstop under Bankr's own limits).
VAULT_MAX_WRITES_PER_DAY=20

BANKR_API_URL=https://api.bankr.bot
