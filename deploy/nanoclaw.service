# systemd unit — for LicheeRV Nano images that ship systemd (e.g. Debian/sd).
# Install: cp to /etc/systemd/system/ && systemctl enable --now nanoclaw
[Unit]
Description=nanoclaw pocket AI agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/root/nanoclaw
WorkingDirectory=/root
Restart=always
RestartSec=10
# 256 MB board — keep the agent honest
MemoryMax=180M
# Wallet-key encryption secret, generated by deploy/gen-secret.sh into a
# root-600 file (ideally off the data card). Comment out to disable wallets.
EnvironmentFile=-/etc/nanoclaw.secret

[Install]
WantedBy=multi-user.target
