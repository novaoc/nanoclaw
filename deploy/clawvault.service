# clawvault — key custody daemon. Runs as its OWN unprivileged user so a
# compromised nanoclaw (even with a shell) can't read its files or env.
# Install: create the user, then enable this unit.
#
#   useradd --system --home /var/lib/clawvault --shell /usr/sbin/nologin clawvault
#   install -o clawvault -g clawvault -m 700 -d /var/lib/clawvault
#   # secret + its own Discord token, readable ONLY by clawvault:
#   install -o clawvault -g clawvault -m 600 /etc/clawvault.env   # NANOCLAW_SECRET, VAULT_DISCORD_TOKEN, …
#   # let nanoclaw's user reach the socket (group membership):
#   usermod -aG clawvault nanoclaw
[Unit]
Description=clawvault key custody daemon
After=network-online.target
Wants=network-online.target

[Service]
User=clawvault
Group=clawvault
ExecStart=/usr/local/bin/clawvault
WorkingDirectory=/var/lib/clawvault
EnvironmentFile=/etc/clawvault.env
Environment=CLAWVAULT_DATA=/var/lib/clawvault
Environment=CLAWVAULT_SOCKET=/var/lib/clawvault/clawvault.sock
Restart=always
RestartSec=10
MemoryMax=80M
# containment — the whole point
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/clawvault

[Install]
WantedBy=multi-user.target
