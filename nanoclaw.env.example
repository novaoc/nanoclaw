# nanoclaw configuration — copy to /etc/nanoclaw.env on the board
# (or keep next to the binary as ./nanoclaw.env)

# Discord bot token — https://discord.com/developers/applications
# Enable the MESSAGE CONTENT intent under Bot settings.
DISCORD_TOKEN=

# DeepSeek API key — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Channels answered WITHOUT an @mention (comma-separated channel IDs).
# Everywhere else the bot answers when @mentioned, and in DMs.
FOCUS_CHANNELS=

# Where memory, history, and artifacts live — point at the microSD mount.
NANOCLAW_DATA=/mnt/sd/nanoclaw

# deepseek-chat (tool calling, cheap) — deepseek-reasoner has no tool support.
# If your account has a flash-tier model, use it: nanoclaw is built around the
# looper play (cheap model × more passes > pricey model × one shot).
NANOCLAW_MODEL=deepseek-chat

# Self-review passes for /dive (1-5). 2 = draft + one critique/repair round.
NANOCLAW_DIVE_PASSES=2

# ── Bankr (optional): token design + per-user wallets on Base ───────────
# Each user connects THEIR OWN Bankr key via /connect (private, ephemeral);
# Vela then trades only on that person's wallet, recognized by Discord id.
# Token strategy needs no key and works without any of this.
BANKR_API_URL=https://api.bankr.bot

# NANOCLAW_SECRET turns the whole wallet feature ON and encrypts every
# connected key at rest (AES-GCM). Without it, /connect is disabled and no
# keys are ever stored. Use a long random value (e.g. `openssl rand -hex 32`).
#
# IMPORTANT for "not even the SD holder can read the keys": the encrypted
# files live on the microSD, but this secret must NOT. Supply it from off the
# data card — e.g. a systemd drop-in on a different mount, entered at boot, or
# a small USB key that stays with you. If the secret sits on the same SD, a
# stolen card can decrypt. Anything a running root user can do is out of scope
# for any bot that spends autonomously — this protects the card, not root.
NANOCLAW_SECRET=
